/* 学习页专属样式 */

.study-page {
  padding-top: 20rpx;
}

.loading-tip {
  text-align: center;
  color: #999999;
  font-size: 26rpx;
  padding: 120rpx 0;
}

.empty-btn {
  display: inline-flex;
  padding: 0 56rpx;
}

/* ---------- 顶部进度 ---------- */

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.top-progress {
  font-size: 28rpx;
  color: #333333;
}

.top-current {
  font-size: 40rpx;
  font-weight: 700;
  color: #4a6cf7;
}

.top-total {
  color: #999999;
}

.bar-track {
  height: 8rpx;
  background: #eef1fe;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
}

.bar-fill {
  height: 100%;
  background: #4a6cf7;
  border-radius: 4rpx;
  transition: width 0.25s ease;
}

/* ---------- 单词卡 ---------- */

.word-card {
  background: #ffffff;
  border-radius: 28rpx;
  min-height: 460rpx;
  padding: 48rpx 36rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 24rpx rgba(74, 108, 247, 0.08);
}

/* 翻面动画约 200ms（prd F4 要求） */
.card-flipped {
  animation: flip-in 0.2s ease;
}

@keyframes flip-in {
  from {
    transform: rotateY(80deg);
    opacity: 0.4;
  }
  to {
    transform: rotateY(0);
    opacity: 1;
  }
}

.card-face {
  width: 100%;
  text-align: center;
}

.word-text {
  font-size: 68rpx;
  font-weight: 700;
  color: #333333;
  letter-spacing: 1rpx;
  word-break: break-word;
}

.word-phonetic {
  font-size: 28rpx;
  color: #999999;
  margin-top: 20rpx;
}

.word-small {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
}

.word-phonetic-small {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
  margin-bottom: 20rpx;
}

.meaning-list {
  text-align: left;
}

.meaning-item {
  font-size: 30rpx;
  color: #333333;
  line-height: 1.8;
  padding-left: 24rpx;
  position: relative;
}

.meaning-item::before {
  content: '·';
  position: absolute;
  left: 4rpx;
  color: #4a6cf7;
  font-weight: 700;
}

.flip-hint {
  font-size: 22rpx;
  color: #c0c0c6;
  margin-top: 32rpx;
}

/* ---------- AI 例句 ---------- */

.ai-area {
  margin-top: 28rpx;
}

.ai-btn {
  width: 100%;
}

.ai-error {
  color: #d4380d;
  font-size: 24rpx;
  background: #fff1f0;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-top: 16rpx;
}

.ai-panel {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-top: 20rpx;
}

.ai-en {
  font-size: 30rpx;
  color: #333333;
  line-height: 1.7;
}

.ai-cn {
  font-size: 26rpx;
  color: #666666;
  margin-top: 12rpx;
  line-height: 1.7;
}

.ai-mnemonic-label {
  font-size: 24rpx;
  color: #4a6cf7;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.ai-mnemonic {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.7;
}

.ai-close {
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  padding-top: 20rpx;
}

/* ---------- 认识 / 不认识 ---------- */

.answer-row {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.answer-btn {
  flex: 1;
  min-height: 96rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
}

.answer-no {
  background: #fff1f0;
  color: #d4380d;
  border: 1rpx solid #ffccc7;
}

.answer-yes {
  background: #f6ffed;
  color: #52c41a;
  border: 1rpx solid #b7eb8f;
}

/* ---------- 上一个 ---------- */

.nav-row {
  margin-top: 20rpx;
}

.nav-btn {
  display: inline-flex;
  align-items: center;
  min-height: 64rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #666666;
}

.nav-disabled {
  color: #d9d9d9;
  pointer-events: none;
}

/* ---------- 打卡 ---------- */

.checkin-area {
  margin-top: 40rpx;
  padding-bottom: 40rpx;
}

.checkin-tip {
  text-align: center;
  font-size: 24rpx;
  color: #52c41a;
  margin-bottom: 16rpx;
}

.checkin-btn {
  width: 100%;
  min-height: 96rpx;
  font-size: 32rpx;
}

/* ---------- 打卡成功页 ---------- */

.checkin-done {
  text-align: center;
  padding-top: 120rpx;
}

.done-icon {
  font-size: 120rpx;
  line-height: 1.2;
}

.done-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #333333;
  margin-top: 24rpx;
}

.done-streak {
  margin: 60rpx 0 48rpx;
}

.done-streak-num {
  font-size: 120rpx;
  font-weight: 700;
  color: #4a6cf7;
  line-height: 1.1;
}

.done-streak-label {
  font-size: 26rpx;
  color: #999999;
  margin-top: 12rpx;
}

.done-stats {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 36rpx 0;
  margin-bottom: 56rpx;
}

.done-stat {
  flex: 1;
  text-align: center;
}

.done-stat-sep {
  width: 1rpx;
  height: 64rpx;
  background: #eeeeee;
}

.done-stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #333333;
}

.done-stat-label {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

.done-btn {
  width: 100%;
  margin-bottom: 24rpx;
}
