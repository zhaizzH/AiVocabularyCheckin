/* 首页专属样式 */

.home {
  padding-bottom: 60rpx;
}

.hero {
  padding: 12rpx 4rpx 32rpx;
}

.hero-hello {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
}

.hero-sub {
  font-size: 24rpx;
  color: #999999;
  margin-top: 10rpx;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.card-more {
  font-size: 24rpx;
  color: #4a6cf7;
}

.card-hint {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

.card-error {
  font-size: 26rpx;
  color: #d4380d;
  background: #fff1f0;
  padding: 20rpx;
  border-radius: 12rpx;
  text-align: center;
}

/* ---------- 计划卡 ---------- */

.plan-nums {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.plan-big {
  font-size: 64rpx;
  font-weight: 700;
  color: #4a6cf7;
  line-height: 1.1;
}

.plan-total {
  font-size: 32rpx;
  font-weight: 400;
  color: #999999;
}

.plan-label {
  font-size: 24rpx;
  color: #999999;
}

.progress-track {
  height: 12rpx;
  background: #eef1fe;
  border-radius: 6rpx;
  margin: 20rpx 0 16rpx;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: #4a6cf7;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.plan-tip {
  font-size: 24rpx;
  color: #666666;
}

/* ---------- 复习卡 ---------- */

.review-nums {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.review-big {
  font-size: 64rpx;
  font-weight: 700;
  color: #52c41a;
  line-height: 1.1;
}

.review-unit {
  font-size: 24rpx;
  color: #999999;
}

/* ---------- 打卡卡 ---------- */

.streak-row {
  display: flex;
  align-items: center;
}

.streak-item {
  flex: 1;
  text-align: center;
}

.streak-sep {
  width: 1rpx;
  height: 56rpx;
  background: #eeeeee;
}

.streak-num {
  font-size: 52rpx;
  font-weight: 700;
  color: #fa8c16;
  line-height: 1.2;
}

.streak-label {
  font-size: 22rpx;
  color: #999999;
  margin-top: 6rpx;
}

/* ---------- 快捷入口 ---------- */

.quick-row {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.quick-item {
  flex: 1;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 0;
  text-align: center;
}

.quick-icon {
  font-size: 48rpx;
  line-height: 1.2;
}

.quick-text {
  font-size: 24rpx;
  color: #666666;
  margin-top: 10rpx;
}

/* ---------- 骨架屏尺寸 ---------- */

.sk-line {
  height: 28rpx;
  margin-bottom: 16rpx;
  width: 60%;
}

.sk-line-lg {
  height: 64rpx;
  width: 40%;
}
