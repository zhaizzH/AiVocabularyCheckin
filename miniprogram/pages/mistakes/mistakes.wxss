/* 错题本页专属样式 */

.mistakes-page {
  padding-top: 12rpx;
}

/* ---------- 筛选 Tab ---------- */

.tab-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.tab-item {
  flex: 1;
  height: 76rpx;
  border-radius: 20rpx;
  background: #ffffff;
  color: #666666;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.tab-active {
  background: #4a6cf7;
  color: #ffffff;
  font-weight: 600;
}

.badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #ff4d4f;
  color: #ffffff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.loading-tip {
  text-align: center;
  color: #999999;
  font-size: 26rpx;
  padding: 100rpx 0;
}

.error-box {
  background: #fff1f0;
  border-radius: 16rpx;
  padding: 32rpx;
  text-align: center;
}

.error-text {
  color: #d4380d;
  font-size: 26rpx;
}

/* ---------- 条目 ---------- */

.mistake-item {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.item-head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.item-word {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
}

.item-phonetic {
  font-size: 22rpx;
  color: #999999;
}

.item-translation {
  font-size: 26rpx;
  color: #666666;
  margin-top: 8rpx;
}

.item-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
}

.meta-wrong {
  font-size: 22rpx;
  color: #d4380d;
}

.tag-sm {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
}

/* ---------- 操作按钮 ---------- */

.item-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #f5f5f5;
}

.act-btn {
  flex: 1;
  height: 64rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  box-sizing: border-box;
}

.act-ai {
  background: #eef1fe;
  color: #4a6cf7;
}

.act-done {
  background: #f6ffed;
  color: #52c41a;
}

.act-remove {
  background: #f5f5f5;
  color: #999999;
}

.act-busy {
  opacity: 0.5;
  pointer-events: none;
}

/* ---------- 讲解面板 ---------- */

.explain-panel {
  margin-top: 22rpx;
  padding: 24rpx;
  background: #fafbff;
  border-radius: 16rpx;
  border-left: 6rpx solid #4a6cf7;
}

.explain-label {
  font-size: 22rpx;
  color: #4a6cf7;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.explain-label + .explain-text {
  margin-bottom: 16rpx;
}

.explain-text {
  font-size: 26rpx;
  color: #333333;
  line-height: 1.8;
}

.explain-error {
  font-size: 24rpx;
  color: #d4380d;
}

/* ---------- 讲解骨架屏 ---------- */

.sk-line {
  height: 24rpx;
  border-radius: 6rpx;
  background: #eef0f5;
  margin-bottom: 14rpx;
  animation: sk-pulse 1.2s ease-in-out infinite;
}

.sk-w80 { width: 80%; }
.sk-w95 { width: 95%; }
.sk-w60 { width: 60%; }

@keyframes sk-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}

/* ---------- 加载更多 ---------- */

.load-more {
  text-align: center;
  font-size: 22rpx;
  color: #bbbbbb;
  padding: 28rpx 0 16rpx;
}
