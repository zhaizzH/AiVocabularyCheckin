<view class="page-wrap books-page">
  <!-- 分类筛选 -->
  <scroll-view class="cat-bar" scroll-x="{{true}}" show-scrollbar="{{false}}">
    <view class="cat-list">
      <view
        wx:for="{{categories}}"
        wx:key="value"
        class="cat-item {{activeCategory === item.value ? 'cat-active' : ''}}"
        data-value="{{item.value}}"
        bindtap="onSwitchCategory"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <view class="loading-tip" wx:if="{{loading}}">加载中…</view>

  <view class="error-box" wx:elif="{{errorMsg}}">
    <view class="error-text">{{errorMsg}}</view>
  </view>

  <view class="empty" wx:elif="{{books.length === 0}}">
    <view class="empty-icon">📚</view>
    <view class="empty-title">该分类下暂无词书</view>
    <view class="empty-desc">换个分类看看</view>
  </view>

  <block wx:else>
    <view class="book-card" wx:for="{{books}}" wx:key="bookId">
      <view class="book-main">
        <view class="book-head">
          <view class="book-name">{{item.name}}</view>
          <view class="tag">{{item.categoryLabel}}</view>
        </view>

        <view class="book-meta">{{item.wordCount}} 词</view>

        <view class="book-desc ellipsis-2" wx:if="{{item.description}}">{{item.description}}</view>

        <!-- 已加入的显示进度；未加入的只显示词数 -->
        <view class="book-progress" wx:if="{{item.selected}}">
          <view class="progress-track">
            <view class="progress-bar" style="width: {{item.progress}}%"></view>
          </view>
          <view class="progress-text">已学 {{item.learnedCount}}/{{item.wordCount}}</view>
        </view>
      </view>

      <view
        class="book-action {{item.selected ? 'action-remove' : 'action-add'}} {{pendingBookId === item.bookId ? 'action-busy' : ''}}"
        data-bookid="{{item.bookId}}"
        data-selected="{{item.selected}}"
        catchtap="onToggleBook"
      >{{item.selected ? '移出' : '加入'}}</view>
    </view>

    <view class="foot-hint">加入后即可在「学习」页开始今日任务</view>
  </block>
</view>
