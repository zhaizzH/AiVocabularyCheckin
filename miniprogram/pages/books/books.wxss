/* 词书页专属样式 */

.books-page {
  padding-top: 20rpx;
}

.cat-bar {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.cat-list {
  display: inline-flex;
  gap: 16rpx;
}

.cat-item {
  padding: 14rpx 32rpx;
  border-radius: 32rpx;
  background: #ffffff;
  color: #666666;
  font-size: 26rpx;
}

.cat-active {
  background: #4a6cf7;
  color: #ffffff;
}

.loading-tip {
  text-align: center;
  color: #999999;
  font-size: 26rpx;
  padding: 80rpx 0;
}

.error-box {
  background: #fff1f0;
  border-radius: 16rpx;
  padding: 32rpx;
  text-align: center;
}

.error-text {
  color: #d4380d;
  font-size: 26rpx;
}

/* ---------- 词书卡片 ---------- */

.book-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.book-main {
  flex: 1;
  min-width: 0;
}

.book-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.book-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.book-meta {
  font-size: 24rpx;
  color: #999999;
}

/* 截断行为由全局 .ellipsis-2 提供（line-clamp:2），这里只负责间距与配色 */
.book-desc {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

.book-desc {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.book-progress {
  margin-top: 16rpx;
}

.progress-track {
  height: 8rpx;
  background: #eef1fe;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: #4a6cf7;
  border-radius: 4rpx;
}

.progress-text {
  font-size: 22rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* ---------- 操作按钮 ---------- */

.book-action {
  flex-shrink: 0;
  min-width: 120rpx;
  height: 64rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  box-sizing: border-box;
}

.action-add {
  background: #4a6cf7;
  color: #ffffff;
}

.action-remove {
  background: #f5f5f5;
  color: #999999;
}

/* 提交中：降透明度 + 禁止点击，防止连点 */
.action-busy {
  opacity: 0.5;
  pointer-events: none;
}

.foot-hint {
  text-align: center;
  font-size: 22rpx;
  color: #bbbbbb;
  padding: 32rpx 0 20rpx;
}
