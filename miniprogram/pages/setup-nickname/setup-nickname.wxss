/* 设置昵称页专属样式 */

.setup-page {
  padding-top: 60rpx;
}

.header {
  text-align: center;
  margin-bottom: 48rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
}

.header-sub {
  font-size: 24rpx;
  color: #999999;
  margin-top: 12rpx;
}

.section-label {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 20rpx;
}

.avatar-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.avatar-item {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #f7f8fa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  box-sizing: border-box;
  border: 3rpx solid transparent;
}

/* 选中态用描边 + 白底，比只改背景色更容易在 emoji 上辨认 */
.avatar-active {
  border-color: #4a6cf7;
  background: #eef1fe;
}

.field-input {
  height: 88rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.field-placeholder {
  color: #c0c0c6;
}

.counter {
  text-align: right;
  font-size: 22rpx;
  color: #bbbbbb;
  margin-top: 10rpx;
}

.error {
  color: #d4380d;
  font-size: 24rpx;
  background: #fff1f0;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-top: 20rpx;
}

.skip {
  text-align: center;
  font-size: 26rpx;
  color: #999999;
  margin-top: 36rpx;
  /* PRD 验收：可点元素高度 ≥88rpx（行高 36 + padding 两倍 56） */
  padding: 28rpx 20rpx;
  line-height: 36rpx;
}
