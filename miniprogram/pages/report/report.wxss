/* AI 报告页专属样式 */

.report-page {
  padding-top: 20rpx;
}

/* ---------- 全屏 loading ---------- */

.loading-wrap {
  padding-top: 180rpx;
  text-align: center;
}

.loading-spinner {
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto;
  border: 6rpx solid #eef1fe;
  border-top-color: #4a6cf7;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-title {
  font-size: 30rpx;
  color: #333333;
  font-weight: 600;
  margin-top: 36rpx;
}

.loading-desc {
  font-size: 24rpx;
  color: #999999;
  margin-top: 12rpx;
}

.empty-btn {
  display: inline-flex;
  padding: 0 56rpx;
}

/* ---------- 报告内容 ---------- */

.report-head {
  text-align: center;
  padding: 20rpx 0 40rpx;
}

.report-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
}

.report-time {
  font-size: 22rpx;
  color: #999999;
  margin-top: 12rpx;
}

.section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.section-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.dot-blue { background: #4a6cf7; }
.dot-orange { background: #fa8c16; }
.dot-green { background: #52c41a; }

.section-body {
  font-size: 27rpx;
  color: #555555;
  line-height: 1.85;
}

/* ---------- 底部 ---------- */

.report-foot {
  padding: 24rpx 0 40rpx;
}

.foot-note {
  text-align: center;
  font-size: 22rpx;
  color: #bbbbbb;
  margin-bottom: 20rpx;
}

.foot-btn {
  width: 100%;
}
