/* 我的页专属样式 */

.me-page {
  padding-top: 12rpx;
}

/* ---------- 骨架屏 ---------- */

.sk-card,
.sk-list {
  border-radius: 24rpx;
  background: #eef0f5;
  animation: sk-pulse 1.2s ease-in-out infinite;
}

.sk-card {
  height: 240rpx;
  margin-bottom: 20rpx;
}

.sk-list {
  height: 400rpx;
}

@keyframes sk-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}

/* ---------- 用户卡 ---------- */

.user-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 36rpx 28rpx;
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #eef1fe;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-edit {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #4a6cf7;
  color: #ffffff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #ffffff;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.nickname-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.nickname {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 320rpx;
}

.edit-hint {
  font-size: 22rpx;
  color: #4a6cf7;
  flex-shrink: 0;
}

.nickname-edit {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.nickname-input {
  height: 64rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  color: #333333;
}

.edit-btns {
  display: flex;
  gap: 20rpx;
  justify-content: flex-end;
}

.edit-cancel {
  font-size: 24rpx;
  color: #999999;
}

.edit-save {
  font-size: 24rpx;
  color: #4a6cf7;
  font-weight: 600;
}

.edit-save-busy {
  opacity: 0.4;
  pointer-events: none;
}

.username {
  font-size: 24rpx;
  color: #999999;
  margin-top: 10rpx;
}

.join-info {
  font-size: 22rpx;
  color: #bbbbbb;
  margin-top: 12rpx;
}

.join-sep {
  margin: 0 8rpx;
}

/* ---------- 功能列表 ---------- */

.menu-group {
  background: #ffffff;
  border-radius: 24rpx;
  margin-top: 20rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item-last {
  border-bottom: none;
}

.menu-icon {
  font-size: 32rpx;
}

.menu-label {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.menu-arrow {
  font-size: 32rpx;
  color: #cccccc;
}

/* ---------- 退出登录 ---------- */

.btn-logout {
  margin-top: 40rpx;
  height: 92rpx;
  border-radius: 46rpx;
  border: 2rpx solid #ff4d4f;
  color: #ff4d4f;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  box-sizing: border-box;
}

/* ---------- 头像弹层 ---------- */

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
}

.sheet-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 28rpx;
}

.avatar-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.avatar-option {
  height: 140rpx;
  border-radius: 20rpx;
  background: #f7f8fa;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid transparent;
  box-sizing: border-box;
}

.avatar-option-active {
  border-color: #4a6cf7;
  background: #eef1fe;
}

.sheet-cancel {
  margin-top: 28rpx;
  height: 84rpx;
  border-radius: 42rpx;
  background: #f7f8fa;
  color: #666666;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
