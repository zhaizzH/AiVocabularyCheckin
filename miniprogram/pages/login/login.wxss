/* 登录页专属样式 */

.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #4a6cf7 0%, #6b86ff 220rpx, #f7f8fa 420rpx);
  padding: 0 40rpx 60rpx;
}

.brand {
  text-align: center;
  padding: 90rpx 0 60rpx;
}

.brand-logo {
  font-size: 100rpx;
  line-height: 1.2;
  margin-bottom: 20rpx;
}

.brand-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.brand-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  margin-top: 12rpx;
}

.tabs {
  display: flex;
  border-bottom: 1rpx solid #eeeeee;
  margin-bottom: 32rpx;
}

.tab {
  flex: 1;
  text-align: center;
  /* PRD 验收：可点元素高度 ≥88rpx（行高 48 + padding 两倍） */
  padding: 20rpx 0;
  line-height: 48rpx;
  font-size: 30rpx;
  color: #999999;
  position: relative;
}

.tab-active {
  color: #4a6cf7;
  font-weight: 600;
}

.tab-active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -1rpx;
  transform: translateX(-50%);
  width: 64rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #4a6cf7;
}

.field {
  margin-bottom: 28rpx;
}

.field-label {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.field-input {
  height: 88rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.field-placeholder {
  color: #c0c0c6;
}

.error {
  color: #d4380d;
  font-size: 24rpx;
  background: #fff1f0;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.submit-btn {
  margin-top: 8rpx;
}

.divider-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 40rpx 0 32rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #e0e0e0;
}

.divider-text {
  font-size: 24rpx;
  color: #bbbbbb;
}

.btn-wx {
  background: #ffffff;
  color: #07c160;
  border: 1rpx solid #07c160;
}

.footnote {
  text-align: center;
  font-size: 22rpx;
  color: #bbbbbb;
  margin-top: 48rpx;
}
