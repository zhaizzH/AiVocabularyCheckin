# ai-service 环境变量模板
#
# 用法：复制为 .env 后填入真实值。.env 已被 .gitignore 忽略（与 .env.example 不同），
# 绝不要把真实 key 提交进仓库，也不要写进任何代码文件。

# —— DeepSeek API key ——
# 必填（缺失时服务仍能启动，但调用 AI 接口会返回 503 ai_service_llm_not_configured）。
# 占位符刻意不使用 sk- 前缀，避免仓库的红线自查脚本误命中。
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# —— 供应商端点 ——
# OpenAI 兼容；官方当前写法不带 /v1。
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名随供应商迭代会变，故做成变量。当前有效值：deepseek-flash
# （deepseek-chat / deepseek-reasoner 已于 2026-07-24 退役）
DEEPSEEK_MODEL=deepseek-flash

# —— 思考模式 ——
# 必须为 false。JSON 输出模式与 DeepSeek thinking 冲突（会返回空 content），
# 所有请求都显式发送 thinking: disabled。设为 true 会导致启动校验失败。
DEEPSEEK_THINKING_ENABLED=false

# —— 重试 ——
# 仅覆盖连接错误/5xx/429；4xx 不重试。
DEEPSEEK_MAX_RETRIES=2

# —— 超时预算（单位：秒）——
# 请求级总 deadline 必须小于 backend 侧的 15/30/60s，
# 否则 backend 先超时，我们的重试与解析全是白做工。
EXAMPLE_TIMEOUT_S=12
EXPLAIN_TIMEOUT_S=25
REPORT_TIMEOUT_S=50
# 单次模型 HTTP 尝试的上限；与上面的总 deadline 职责分离。
# 取 5 而非 10，是为了让 example 的 12s 预算内真的容得下一次重试。
LLM_ATTEMPT_TIMEOUT_S=5

# —— 日志 ——
LOG_LEVEL=INFO
