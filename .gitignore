# Secrets & local-only config (NEVER commit)
.env
.env.*
!.env.example
application-local.yml
application-local.yaml
application-local.properties
*.local.yml
*local-config*

# Local AI tooling scratch (contains MCP tokens)
.tmp/
.vocab-checkin-tmp/

# AI agent platform scaffolding (local-only tooling, not part of the product)
# These are generated by Trellis/AI IDEs and contain per-machine paths and
# internal dev-loop notes. Re-create locally with `trellis init` after clone.
.claude/
.agents/
.pi/
.workbuddy/

# Vocab source data (7-10MB per file, fetched by script, not committed)
data/vocab-source/*.jsonl
data/vocab-source/*.json
data/*.jsonl

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node
node_modules/
dist/
*.tsbuildinfo
.verify_*.cjs
.verify_entry.ts
frontend/.env
.vite/

# Java / Maven
target/
*.class

# Mini program local build output
miniprogram/.dist/
project.private.config.json

# Mini program code-upload private keys (never commit)
*.key
private.*.key

# OS / editors
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/settings.json

# Local absolute paths must never be baked into tracked docs.
# If a doc needs to reference the repo root, use a relative path instead.
