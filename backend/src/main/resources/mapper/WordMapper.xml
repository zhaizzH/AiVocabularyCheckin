<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.vocab.mapper.WordMapper">

    <!--
      词库导入专用：多行 VALUES 批量插入。

      不用 `saveBatch`：其语义是「循环调用单条 insert」（见 3.5.9 字节码：
      saveBatch -> saveBatch(collection, 1000) -> 逐条 insert），对 22761 行车库
      意味着 22761 次数据库往返。本语句一条 SQL 插 N 行，才是真正的一次往返。

      时间列：`create_time` / `update_time` 无 DB 默认值（G2 决策：时间列不带
      DEFAULT，填充唯一来源是 MyBatis-Plus MetaObjectHandler）。本语句绕过了
      MetaObjectHandler，因此必须显式写 NOW()——这是 design.md §3.5 约束的兑现点。
      `deleted` 也显式置 0：`@TableLogic` 的默认值只在 MP 自己拼 SQL 时生效。
    -->
    <insert id="insertBatch" parameterType="java.util.List">
        INSERT INTO `word`
            (`book_id`, `word`, `phonetic`, `translation`,
             `definition`, `example`, `audio_url`,
             `deleted`, `create_time`, `update_time`)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.bookId}, #{item.word}, #{item.phonetic}, #{item.translation},
             #{item.definition}, #{item.example}, #{item.audioUrl},
             0, NOW(), NOW())
        </foreach>
    </insert>

    <!--
      今日计划的新词候选：该词书内「按 id 升序未学、且今天还没选过」的前 N 个词。

      判定「历史上已学过」用 create_time < dayStart 且 learned = 1：
        * create_time 是**首次进入学习计划**时写入的，之后不再变化
          （update_time 会在每次复习/重学后被刷新，不能用来判断「历史上学过」——
          否则一个词在第二天被复习后，update_time 变成当天，它就会重新变成「新词」，
          以致同一本书反复从头开始）；
        * 创建于今天及以后的词——它们是「今天已经选中的词」，必须继续留在候选集里
          （否则每上报一个词就会补进一个新词，计划窗口不断后滑、永远无法打卡）；
        * 创建于今天的 00:00 之前且已学过的词——历史已学，不再作为新词
          （它们应出现在 §4.1 的待复习列表里）。
      注意：不能写成「有没有 word_progress 行」，否则今天刚上报的词会立即消失。
      dayStart 由 Service 用 Clock 计算后传入，不用 CURDATE()——保证 H2 测试
      与 MySQL 生产同一份 SQL 语义，并可注入固定日期做单测。

      deleted = 0 必须显式写（mapping 层不介入本语句）。
    -->
    <select id="selectUnlearnedNewWordIds" resultType="java.lang.Long">
        SELECT w.id
        FROM `word` w
        WHERE w.book_id = #{bookId}
          AND w.deleted = 0
          AND NOT EXISTS (
              SELECT 1
              FROM `word_progress` p
              WHERE p.user_id = #{userId}
                AND p.word_id = w.id
                AND p.deleted = 0
                AND p.create_time &lt; #{dayStart}
                AND p.learned = 1
          )
        ORDER BY w.id ASC
        LIMIT #{limit}
    </select>

</mapper>
